{
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".txt": "text/plain",
    ".xml": "application/xml"
  }
}
